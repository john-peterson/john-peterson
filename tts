test ! -f $1 && echo no $1 && exit

tmux rename-window "tts/$1"
quit() {
tmux set automatic-rename on
exit
}

# dumpsys activity -p com.termux.api p com.termux.api |grep -q isFrozen=true
# if test $? -eq 0; then
